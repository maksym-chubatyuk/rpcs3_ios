+	// iOS: POSIX shared memory may be refused by the app sandbox. Fall back to an unlinked file in
+	// the app's temporary directory; it is mapped MAP_SHARED exactly like a shm object.
+	static int ios_shared_memory_fd(const std::string& name)
+	{
+		int fd = ::shm_open(name.c_str(), O_RDWR | O_CREAT | O_EXCL, S_IWUSR | S_IRUSR);
+
+		if (fd >= 0)
+		{
+			::shm_unlink(name.c_str());
+			return fd;
+		}
+
+		if (errno == EMFILE)
+		{
+			fmt::throw_exception("Too many open files. Raise the limit and try again.");
+		}
+
+		const char* tmp = ::getenv("TMPDIR");
+		std::string path = tmp && *tmp ? tmp : "/tmp/";
+
+		if (path.back() != '/')
+		{
+			path += '/';
+		}
+
+		path += "rpcs3-mem-XXXXXX";
+		fd = ::mkstemp(path.data());
+		ensure(fd >= 0, "Cannot create a backing file for shared memory");
+		::unlink(path.c_str());
+		return fd;
+	}
