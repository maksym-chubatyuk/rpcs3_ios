Memory setup for iOS: no MAP_JIT, a 24 GiB guest map instead of 56 GiB (the hook region is unused), shared memory from a file when shm_open is unavailable.

diff --git a/rpcs3/Emu/Memory/vm.cpp b/rpcs3/Emu/Memory/vm.cpp
index ae7e3dd70..394ac7e5d 100644
--- a/rpcs3/Emu/Memory/vm.cpp
+++ b/rpcs3/Emu/Memory/vm.cpp
@@ -48,11 +48,21 @@ namespace vm
 	// Auxiliary virtual memory for executable areas
 	u8* const g_exec_addr = memory_reserve_4GiB(g_sudo_addr, 0x300000000);
 
+#ifdef RPCS3_IOS
+	// iOS: an app's user address map ends at 63 GiB (0xFC0000000) without the extended virtual
+	// addressing entitlement, which free developer accounts cannot get. The 32 GiB hook region is
+	// not used by anything outside this file, so it is left out and the rest (24 GiB) fits.
+	u8* const g_hook_addr = nullptr;
+
+	// Stats for debugging
+	u8* const g_stat_addr = memory_reserve_4GiB(g_exec_addr + 0x200000000);
+#else
 	// Hooks for memory R/W interception (default: zero offset to some function with only ret instructions)
 	u8* const g_hook_addr = memory_reserve_4GiB(g_exec_addr, 0x800000000);
 
 	// Stats for debugging
 	u8* const g_stat_addr = memory_reserve_4GiB(g_hook_addr);
+#endif
 
 	// For SPU
 	u8* const g_free_addr = g_stat_addr + 0x1'0000'0000;
@@ -2306,7 +2316,9 @@ namespace vm
 
 	inline namespace ps3_
 	{
+#ifndef RPCS3_IOS
 		static utils::shm s_hook{0x800000000, ""};
+#endif
 
 		void init()
 		{
@@ -2345,7 +2357,9 @@ namespace vm
 #ifdef _WIN32
 			utils::memory_release(g_hook_addr, 0x800000000);
 #endif
+#ifndef RPCS3_IOS
 			ensure(s_hook.map(g_hook_addr, utils::protection::rw, true));
+#endif
 		}
 	}
 
@@ -2372,7 +2386,7 @@ namespace vm
 #ifdef _WIN32
 		s_hook.unmap(g_hook_addr);
 		ensure(utils::memory_reserve(0x800000000, g_hook_addr));
-#else
+#elif !defined(RPCS3_IOS)
 		utils::memory_decommit(g_hook_addr, 0x800000000);
 #endif
 
