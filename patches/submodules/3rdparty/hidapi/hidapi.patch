hidapi on iOS: no IOKit HID backend, and Darwin has no pthread_barrier for the libusb backend.

diff --git a/libusb/hidapi_thread_pthread.h b/libusb/hidapi_thread_pthread.h
index 0abe733..871794f 100644
--- a/libusb/hidapi_thread_pthread.h
+++ b/libusb/hidapi_thread_pthread.h
@@ -24,7 +24,7 @@
 
 #include <pthread.h>
 
-#if defined(__ANDROID__) && __ANDROID_API__ < __ANDROID_API_N__
+#if (defined(__ANDROID__) && __ANDROID_API__ < __ANDROID_API_N__) || defined(__APPLE__) /* Darwin has no pthread_barrier either */
 
 /* Barrier implementation because Android/Bionic don't have pthread_barrier.
    This implementation came from Brent Priddy and was posted on
